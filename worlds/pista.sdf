<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="pista_robot">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <camera_pose>5 -6 12 0 0.8 1.57</camera_pose>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"/>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
    </gui>

    <scene>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= PAREDES EXTERIORES ================= -->
    <model name="muro_norte">
      <static>true</static><pose>5 5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>10 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 0.2 1</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>
    
    <model name="muro_sur">
      <static>true</static><pose>5 -5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>10 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 0.2 1</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>

    <model name="muro_oeste_arriba">
      <static>true</static><pose>0 3 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 3.8 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 3.8 1</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>
    
    <model name="muro_oeste_abajo">
      <static>true</static><pose>0 -3 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 3.8 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 3.8 1</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>

    <model name="muro_este_abajo">
      <static>true</static><pose>10 -0.9 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 8.0 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 8.0 1</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual></link>
    </model>

    <!-- ================= PAREDES INTERNAS ================= -->
    <model name="muro_interno_1">
      <static>true</static><pose>3.3 -1.5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 6.8 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 6.8 1</size></box></geometry><material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.3 0.6 1</diffuse></material></visual></link>
    </model>

    <model name="muro_interno_2a">
      <static>true</static><pose>3.9 2.0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.0 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 0.2 1</size></box></geometry><material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.3 0.6 1</diffuse></material></visual></link>
    </model>

    <model name="muro_interno_2b">
      <static>true</static><pose>6.1 2.0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.0 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 0.2 1</size></box></geometry><material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.3 0.6 1</diffuse></material></visual></link>
    </model>

    <model name="muro_interno_3">
      <static>true</static><pose>6.7 1.4 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 7.0 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 7.0 1</size></box></geometry><material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.3 0.6 1</diffuse></material></visual></link>
    </model>

    <model name="muro_interno_4">
      <static>true</static><pose>7.65 -2.0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.7 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.7 0.2 1</size></box></geometry><material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.3 0.6 1</diffuse></material></visual></link>
    </model>

    <!-- ================= LA TRAMPA DEL INICIO (Cuarto Falso) ================= -->
    <model name="muro_falso_inicio_a">
      <static>true</static><pose>0.7 -2.5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.4 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.4 0.2 1</size></box></geometry><material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.3 0.6 1</diffuse></material></visual></link>
    </model>

    <model name="muro_falso_inicio_b">
      <static>true</static><pose>2.75 -2.5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.1 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.1 0.2 1</size></box></geometry><material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.3 0.6 1</diffuse></material></visual></link>
    </model>

    <!-- ================= LA TRAMPA FINAL ================= -->
    <model name="muro_trampa_vertical">
      <static>true</static><pose>8.3 1.0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.2 4.0 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 4.0 1</size></box></geometry><material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.3 0.6 1</diffuse></material></visual></link>
    </model>
    
    <model name="muro_trampa_horizontal">
      <static>true</static><pose>9.15 3.1 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.5 0.2 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.5 0.2 1</size></box></geometry><material><ambient>0.1 0.3 0.6 1</ambient><diffuse>0.1 0.3 0.6 1</diffuse></material></visual></link>
    </model>

    <!-- ================= OBSTÁCULOS ================= -->
    <model name="obstaculo_cilindro_1">
      <static>true</static><pose>1.6 2.0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry><material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material></visual></link>
    </model>

    <model name="obstaculo_esfera_1">
      <static>true</static><pose>5.0 3.5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><sphere><radius>0.6</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.6</radius></sphere></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <model name="obstaculo_cilindro_2">
      <static>true</static><pose>4.5 0.0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry><material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material></visual></link>
    </model>
    
    <model name="obstaculo_cilindro_3">
      <static>true</static><pose>5.7 -1.0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry><material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material></visual></link>
    </model>

    <model name="obstaculo_esfera_2">
      <static>true</static><pose>7.5 -3.5 0.6 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><sphere><radius>0.6</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.6</radius></sphere></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <model name="obstaculo_esfera_3">
      <static>true</static><pose>8.8 -2.5 0.4 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><sphere><radius>0.4</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.4</radius></sphere></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual></link>
    </model>

    <model name="obstaculo_cilindro_4">
      <static>true</static><pose>7.5 1.5 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry><material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>