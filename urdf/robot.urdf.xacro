<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_diferencial">

    <!-- Parámetros requeridos por la guía -->
    <xacro:property name="wheel_radius" value="0.05" />
    <xacro:property name="wheel_separation" value="0.30" />
    <xacro:property name="chassis_length" value="0.4" />
    <xacro:property name="chassis_width" value="0.25" />
    <xacro:property name="chassis_height" value="0.1" />
    
    <!-- Masas estimadas (justifícalas luego en Notion) -->
    <xacro:property name="chassis_mass" value="2.0" />
    <xacro:property name="wheel_mass" value="0.5" />
    <xacro:property name="caster_mass" value="0.2" />

    <!-- Macros matemáticas de Inercia (Clave para Gazebo) -->
    <xacro:macro name="box_inertia" params="m x y z">
        <inertial>
            <origin xyz="0 0 ${z/2}" rpy="0 0 0"/>
            <mass value="${m}" />
            <inertia ixx="${(1/12) * m * (y*y + z*z)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12) * m * (x*x + z*z)}" iyz="0.0"
                     izz="${(1/12) * m * (x*x + y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r h">
        <inertial>
            <mass value="${m}" />
            <inertia ixx="${(1/12) * m * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
                     iyy="${(1/12) * m * (3*r*r + h*h)}" iyz="0.0"
                     izz="${(1/2) * m * r*r}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r">
        <inertial>
            <mass value="${m}" />
            <inertia ixx="${(2/5) * m * r*r}" ixy="0.0" ixz="0.0"
                     iyy="${(2/5) * m * r*r}" iyz="0.0"
                     izz="${(2/5) * m * r*r}" />
        </inertial>
    </xacro:macro>

    <!-- Link Base (Proyección en el suelo) -->
    <link name="base_footprint"/>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="chassis"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- Chasis -->
    <link name="chassis">
        <visual>
            <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 0.8 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
    </link>

    <!-- Macro para Ruedas Motrices -->
    <xacro:macro name="wheel" params="prefix y_reflect">
        <link name="${prefix}_wheel">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="0.04"/>
                </geometry>
                <material name="black">
                    <color rgba="0.1 0.1 0.1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="0.04"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="0.04"/>
        </link>

        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="chassis"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="0 ${y_reflect * (wheel_separation / 2)} 0" rpy="-1.5708 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>
    </xacro:macro>

    <!-- Instanciar ruedas -->
    <xacro:wheel prefix="left" y_reflect="1" />
    <xacro:wheel prefix="right" y_reflect="-1" />

    <!-- Caster (Rueda loca) -->
    <!-- Caster (Rueda loca) y su soporte -->
    <!-- Caster (Rueda loca) -->
    <link name="caster_wheel">
        <visual>
            <geometry>
                <!-- Aumentamos el radio de la esfera -->
                <sphere radius="${wheel_radius * 0.75}"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius * 0.75}"/>
            </geometry>
        </collision>
        <xacro:sphere_inertia m="${caster_mass}" r="${wheel_radius * 0.75}"/>
    </link>

    <joint name="caster_joint" type="fixed">
        <parent link="chassis"/>
        <child link="caster_wheel"/>
        <!-- El centro baja exactamente la diferencia de radios para garantizar el toque en el suelo -->
        <origin xyz="${-(chassis_length / 2 - 0.05)} 0 ${-(wheel_radius - (wheel_radius * 0.75))}" rpy="0 0 0"/>
    </joint>

<!-- =================================================== -->
    <!-- SENSOR LiDAR                                        -->
    <!-- =================================================== -->
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.04"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.15" r="0.03" h="0.04"/>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="chassis"/>
        <child link="lidar_link"/>
        <!-- Lo ubicamos en el centro del chasis, justo sobre su cara superior -->
        <origin xyz="0 0 ${chassis_height + 0.02}" rpy="0 0 0"/>
    </joint>


    <!-- Reducir fricción en la rueda loca para que deslice suave en Gazebo -->
    <gazebo reference="caster_wheel">
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>

    <!-- Aumentar fricción en las ruedas motrices -->
    <gazebo reference="left_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="right_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

<!-- =================================================== -->
    <!-- SENSOR CÁMARA                                       -->
    <!-- =================================================== -->
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.02 0.04 0.04"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.04 0.04"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="0.05" x="0.02" y="0.04" z="0.04"/>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="chassis"/>
        <child link="camera_link"/>
        <!-- Lo ubicamos en el frente del chasis (eje X positivo) y ligeramente arriba -->
        <origin xyz="${chassis_length / 2} 0 ${chassis_height / 2 + 0.02}" rpy="0 0 0"/>
    </joint>




<!-- =================================================== -->
    <!-- PLUGINS DE GAZEBO PARA ROS 2 (JAZZY / HARMONIC)     -->
    <!-- =================================================== -->
    <gazebo>
        <!-- 1. Plugin de Tracción Diferencial -->
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <!-- Juntas motrices -->
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            
            <!-- Parámetros dinámicos vinculados a tus variables Xacro -->
            <wheel_separation>${wheel_separation}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            
            <!-- Configuración de odometría y comandos -->
            <odom_publish_frequency>50</odom_publish_frequency>
            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>

        <!-- 2. Plugin Publicador de Estado de Juntas (Requerido para el cálculo del error cinemático) -->
        <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>left_wheel_joint</joint_name>
            <joint_name>right_wheel_joint</joint_name>
        </plugin>
    </gazebo>

    <!-- Configuración del sensor LiDAR para Gazebo -->
    <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <topic>/scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
            </lidar>
        </sensor>
    </gazebo>


    <!-- Configuración de la cámara para Gazebo -->
    <gazebo reference="camera_link">
        <sensor name="camera_sensor" type="camera">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <!-- FPS definidos -->
            <update_rate>30.0</update_rate>
            <topic>/image_raw</topic>
            <gz_frame_id>camera_link</gz_frame_id>
            <camera>
                <horizontal_fov>1.39626</horizontal_fov>
                <image>
                    <!-- Resolución definida -->
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.02</near>
                    <far>300</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>



</robot>

